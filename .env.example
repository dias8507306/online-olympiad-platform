# Copy to .env.34 / .env.56 for a real deployment. Without these files dev-server.mjs runs in DEMO mode.
# Which site this deployment serves: 34 (grades 3–4) or 56 (grades 5–6)
GROUP=34
# Postgres connection string (Neon serverless). Leave empty for DEMO mode (in-memory PGlite + random data).
OLYMP_DATABASE_URL=your-postgres-connection-string-here
# Dashboard (/admin) password
ADMIN_PASSWORD=your-admin-password-here
